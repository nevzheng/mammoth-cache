"""mammoth-cache: a remote build cache node for Gradle and Maven."""

module(
    name = "mammoth_cache",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.74.0")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# Rust toolchain. Keep the version in step with rust-toolchain.toml; CI checks that they match
# (scripts/check-toolchain-sync.sh).
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.98.1",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates. Cargo.toml and Cargo.lock stay the source of truth: crate_universe reads
# them, so a dependency is added with `cargo add` and Bazel picks it up on the next build.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# Python for the end-to-end, acceptance and load suites under tests/ (doc 0011). tests/uv.lock is the
# source of truth, as Cargo.lock is for crates: change dependencies with `uv add` in tests/ and
# Bazel reads the lock on the next build.
bazel_dep(name = "rules_python", version = "2.4.2", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip.parse(
    hub_name = "tests_pypi",
    python_version = "3.14",
    uv_lock = "//tests:uv.lock",
)
use_repo(pip, "tests_pypi")

# No implicit __init__.py files in runfiles: the suites' packages have their own.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config", dev_dependency = True)
rules_python_config.explicit_init_py(default = True)
