# Bazel settings shared by every contributor and CI. Put machine-specific settings (a disk cache,
# a remote cache, a registry mirror) in user.bazelrc, which is git-ignored.

# Cargo.lock pins the crates and MODULE.bazel pins exact module versions. A MODULE.bazel.lock would
# also record a digest of Cargo.lock, so every Dependabot or release-plz bump would need a Bazel run.
common --lockfile_mode=off

# Match `cargo build`: warnings are errors in CI only (see --config=ci).
build --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --incompatible_strict_action_env

test --test_output=errors

# `bazel build --config=lint //...` runs clippy and rustfmt over every Rust target.
build:lint --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:lint --output_groups=+clippy_checks
build:lint --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:lint --output_groups=+rustfmt_checks

# Same flags as the Cargo CI jobs (RUSTFLAGS=-Dwarnings).
common:ci --@rules_rust//rust/settings:extra_rustc_flag=-Dwarnings
common:ci --@rules_rust//rust/settings:clippy_flag=-Dwarnings
common:ci --color=yes
common:ci --curses=no
common:ci --show_progress_rate_limit=5
build:ci --verbose_failures

# Optimized build, the Bazel counterpart of Cargo's `dist` profile.
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:lto=thin
build:release --@rules_rust//rust/settings:codegen_units=1
build:release --strip=always

# The Compose-backed Python suites (//tests:e2e, //tests:acceptance_*), which drive Docker, Java,
# Gradle, Maven, Bazel and Buck2 on the host. Pass any other MAMMOTH_E2E_* override with
# --test_env=NAME.
# CI selects Hypothesis's ci profile (derandomized, no example database), as under `uv run`.
test:e2e --test_env=CI
test:e2e --test_env=HOME
test:e2e --test_env=XDG_CACHE_HOME
test:e2e --test_env=PATH
test:e2e --test_env=DOCKER_HOST
test:e2e --test_env=JAVA_HOME
test:e2e --test_env=JAVA_TOOL_OPTIONS
test:e2e --test_env=HTTPS_PROXY
test:e2e --test_env=NO_PROXY
test:e2e --test_env=SSL_CERT_FILE
test:e2e --test_env=MAMMOTH_IMAGE
test:e2e --test_env=MAMMOTH_E2E_TARGET
test:e2e --test_env=MAMMOTH_E2E_CACHE
test:e2e --test_env=MAMMOTH_E2E_BAZEL_REGISTRIES
test:e2e --test_env=MAMMOTH_E2E_BAZEL_STARTUP_ARGS
test:e2e --test_env=MAMMOTH_E2E_BAZEL_EXAMPLES
test:e2e --test_output=errors
# A full acceptance line can pass Bazel's hour for an enormous test; pytest-timeout still bounds
# each test case.
test:e2e --test_timeout=7200

try-import %workspace%/user.bazelrc
