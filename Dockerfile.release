# syntax=docker/dockerfile:1

# Release image, built by release.yml from the static musl binaries it attaches to the GitHub
# release, so the image and the download are the same bytes. Nothing is compiled here, so both
# architectures build without emulation. `Dockerfile` remains the from-source build for local use.
#
# Build context: a directory holding linux-amd64/mammoth and linux-arm64/mammoth.

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
ARG TARGETARCH
COPY --chmod=0755 linux-${TARGETARCH}/mammoth /mammoth
EXPOSE 5071
USER nonroot
ENTRYPOINT ["/mammoth"]
